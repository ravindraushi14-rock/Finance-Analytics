{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "ovTrend",
  "position": {
    "x": 10,
    "y": 254,
    "z": 18000,
    "height": 222,
    "width": 790,
    "tabOrder": 18000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendar"
                    }
                  },
                  "Property": "Month"
                }
              },
              "queryRef": "Calendar.Month",
              "nativeQueryRef": "Month",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Amount"
                }
              },
              "queryRef": "_Measures.Total Amount",
              "nativeQueryRef": "Amount",
              "displayName": "Amount"
            }
          ],
          "fieldParameters": [
            {
              "parameterExpr": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metric Selector"
                    }
                  },
                  "Property": "Metric Selector"
                }
              },
              "index": 0,
              "length": 1
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Calendar"
                  }
                },
                "Property": "Month"
              }
            },
            "direction": "Ascending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly trend (use the Trend metric slicer)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}